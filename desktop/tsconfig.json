{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/desktop",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": [
    "main/**/*",
    "preload/**/*",
    "renderer/**/*",
    "../core/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
