{
  "name": "stereo",
  "version": "0.1.0",
  "description": "High-performance visual frame player for stereoscopy, sprite animation, and experimental VFX",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
