  "repository": {
    "type": "git",
    "url": "https://github.com/vandalit/stereo"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4"
  }
}
