{
  "name": "stereo",
  "version": "0.1.0",
  "description": "High-performance visual frame player for stereoscopy, sprite animation, and experimental VFX",
  "main": "dist/desktop/main/index.js",
  "types": "dist/core/index.d.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:desktop && npm run copy:assets",
    "build:core": "tsc",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "copy:assets": "cp desktop/renderer/*.html dist/desktop/renderer/ && cp -r desktop/renderer/styles dist/desktop/renderer/ 2>/dev/null || mkdir -p dist/desktop/renderer/styles && cp desktop/renderer/styles/*.css dist/desktop/renderer/styles/",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "echo 'ESLint not configured yet'",
    "typecheck": "tsc --noEmit",
    "demo": "node demo/serve.js",
    "electron": "npm run build && electron .",
    "electron:dev": "NODE_ENV=development npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "keywords": [
    "stereoscopy",
    "frame-player",
    "animation",
    "vfx",
    "canvas",
    "electron",
    "web-component"
  ],
  "author": "vandalit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vandalit/stereo"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4"
  },
  "build": {
    "appId": "com.vandalit.stereo",
    "productName": "Stereo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/renderer/**/*.html",
      "desktop/renderer/**/*.css",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
